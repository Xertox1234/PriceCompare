{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module",
    "project": "./tsconfig.json"
  },
  "plugins": ["@typescript-eslint", "eslint-comments"],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:eslint-comments/recommended"
  ],
  "rules": {
    // CRITICAL: Prevent blanket ESLint disables (Phase 3 of type safety cleanup)
    // Requires specific rules to be disabled, not whole categories
    "eslint-comments/no-unlimited-disable": "error",
    "eslint-comments/require-description": ["error", { "ignore": ["eslint-enable"] }],

    // CRITICAL: Block 'any' types - defeats TypeScript purpose
    "@typescript-eslint/no-explicit-any": "error",

    // CRITICAL: Block unsafe type operations
    // RE-ENABLED 2025-11-29: Audit proved these catch REAL BUGS, not library noise
    // Examples found: floating promises (race conditions), misused promises (unhandled errors), unsafe JSON.parse
    "@typescript-eslint/no-unsafe-assignment": "error",
    "@typescript-eslint/no-unsafe-member-access": "error",
    "@typescript-eslint/no-unsafe-call": "error",
    "@typescript-eslint/no-unsafe-return": "error",
    "@typescript-eslint/no-unsafe-argument": "error",

    // Type quality
    "@typescript-eslint/no-unnecessary-type-assertion": "error",
    "@typescript-eslint/prefer-as-const": "error",
    "@typescript-eslint/no-inferrable-types": "warn",
    "@typescript-eslint/explicit-function-return-type": "off",
    "@typescript-eslint/explicit-module-boundary-types": "off",
    // Non-null assertions bypass TypeScript safety - use type guards instead
    // See docs/01_TYPESCRIPT_PATTERNS.md (Pattern 3: Test file type guards)
    "@typescript-eslint/no-non-null-assertion": "warn",

    // Async/Promise best practices - CRITICAL (prevents race conditions & unhandled errors)
    "@typescript-eslint/no-floating-promises": "error",
    "@typescript-eslint/no-misused-promises": "error",
    // CRITICAL: Only await actual Promises (not void functions)
    // Prevents await-thenable errors (awaiting non-Promise values causes compilation errors)
    // Example: await shutdownWebSocket() where shutdownWebSocket(): void (not Promise<void>)
    "@typescript-eslint/await-thenable": "error",
    // Warn about async functions without await - prevents unnecessary Promise overhead
    // NOTE: Some warnings are acceptable (interface compliance in MemStorage - see storage.ts)
    // Example: async function without await in test mocks, route handlers with only sync calls
    "@typescript-eslint/require-await": "warn",

    // Code quality
    "@typescript-eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "no-var": "error",
    "prefer-const": "error",
    "prefer-arrow-callback": "warn",
    "no-throw-literal": "error",
    "eqeqeq": ["error", "always", { "null": "ignore" }],

    // Security
    "no-console": "error",
    "no-debugger": "error",
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-new-func": "error"
  },
  "overrides": [
    {
      "files": [
        "**/__tests__/**/*.ts",
        "**/__tests__/**/*.tsx",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/test/setup.ts"
      ],
      "rules": {
        // Test files: Allow console for debugging
        "no-console": "off",
        // Test files: Allow file-level disables without enable pair
        // Test mocks and fixtures genuinely require flexible typing throughout
        "eslint-comments/disable-enable-pair": "off",
        // Test files: Relax unsafe rules - test mocks require flexible typing
        // This is documented and justified - see docs/01_TYPESCRIPT_PATTERNS.md
        "@typescript-eslint/no-unsafe-assignment": "off",
        "@typescript-eslint/no-unsafe-member-access": "off",
        "@typescript-eslint/no-unsafe-argument": "off",
        "@typescript-eslint/no-unsafe-call": "off",
        "@typescript-eslint/no-unsafe-return": "off"
      }
    },
    {
      "files": ["**/utils/logger.ts"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      // Interface compliance files: Allow file-level eslint-disable without enable pair
      // These files implement in-memory fallbacks that must match async interfaces
      // The entire file needs the disable, not just specific sections
      // See: docs/LEARNINGS_ESLINT_PRETTIER_CLEANUP_2025.md
      "files": [
        "server/storage.ts",
        "server/config/redis.ts",
        "server/middleware/redis-cache.ts"
      ],
      "rules": {
        "eslint-comments/disable-enable-pair": "off"
      }
    }
  ]
}
