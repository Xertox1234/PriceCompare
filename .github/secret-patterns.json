{
  "patterns": [
    {
      "name": "Hardcoded Password",
      "pattern": "(password|passwd|pwd)\\s*[:=]\\s*[\"'][^\"']+[\"']",
      "severity": "high",
      "description": "Potential hardcoded password found"
    },
    {
      "name": "API Key",
      "pattern": "(api[_-]?key|apikey)\\s*[:=]\\s*[\"'][^\"']+[\"']",
      "severity": "critical",
      "description": "Potential API key found"
    },
    {
      "name": "Secret Token",
      "pattern": "(secret|token)\\s*[:=]\\s*[\"'][a-zA-Z0-9]{20,}[\"']",
      "severity": "high",
      "description": "Potential secret or token found"
    },
    {
      "name": "AWS Access Key",
      "pattern": "AKIA[0-9A-Z]{16}",
      "severity": "critical",
      "description": "AWS Access Key ID found"
    },
    {
      "name": "AWS Secret Key",
      "pattern": "(aws_secret_access_key|aws_secret_key)\\s*[:=]\\s*[\"'][^\"']+[\"']",
      "severity": "critical",
      "description": "AWS Secret Access Key found"
    },
    {
      "name": "Private Key",
      "pattern": "-----BEGIN (RSA|DSA|EC|OPENSSH|PGP) PRIVATE KEY-----",
      "severity": "critical",
      "description": "Private key found in code"
    },
    {
      "name": "Generic Secret",
      "pattern": "(secret|key|password|token|auth)\\s*[:=]\\s*[\"'][^\"']{32,}[\"']",
      "severity": "medium",
      "description": "Potential secret value found"
    },
    {
      "name": "JWT Token",
      "pattern": "eyJ[A-Za-z0-9-_=]+\\.[A-Za-z0-9-_=]+\\.?[A-Za-z0-9-_.+/=]*",
      "severity": "high",
      "description": "JWT token found"
    },
    {
      "name": "Database Connection String",
      "pattern": "(postgresql|mysql|mongodb):\\/\\/[^\\s]+:[^\\s]+@",
      "severity": "critical",
      "description": "Database connection string with credentials"
    },
    {
      "name": "Slack Token",
      "pattern": "xox[pborsa]-[0-9]{12}-[0-9]{12}-[0-9]{12}-[a-z0-9]{32}",
      "severity": "high",
      "description": "Slack token found"
    },
    {
      "name": "GitHub Token",
      "pattern": "gh[pousr]_[A-Za-z0-9_]{36,255}",
      "severity": "critical",
      "description": "GitHub token found"
    },
    {
      "name": "Stripe API Key",
      "pattern": "sk_live_[0-9a-zA-Z]{24,}",
      "severity": "critical",
      "description": "Stripe live API key found"
    },
    {
      "name": "Google API Key",
      "pattern": "AIza[0-9A-Za-z\\-_]{35}",
      "severity": "high",
      "description": "Google API key found"
    }
  ],
  "whitelistPatterns": [
    "process\\.env\\.",
    "getRequiredEnv",
    "getOptionalEnv",
    "CHANGE_THIS",
    "your_",
    "example",
    "\\.env\\.example"
  ]
}
