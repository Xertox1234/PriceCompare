# WARNING 7: Missing error sanitization (should use createErrorResponse)
if echo "$STAGED_FILES" | grep -E "routes/.*\.ts$" | xargs git diff --cached 2>/dev/null | grep -E "^\+" | grep "error\.message" | grep -v "createErrorResponse" >/dev/null 2>&1; then
