# WARNING 8: Unoptimized database queries (SELECT * without field specification)
if echo "$TS_FILES" | xargs git diff --cached 2>/dev/null | grep -E "^\+" | grep -F "db.select()" | grep -v "from(" >/dev/null 2>&1; then
