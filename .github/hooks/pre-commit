# WARNING 14: Type assertions without documentation (Phase 3 - Type Safety)
echo "📋 Checking type assertion documentation..."
# Find all type assertions, then check if previous line has a comment
TYPE_ASSERTIONS=""
for file in $(echo "$TS_FILES" | grep -v "__tests__" | grep -v "\.test\."); do
  # Get assertions with previous line context
  ASSERTIONS_WITH_CONTEXT=$(git diff --cached -U1 "$file" 2>/dev/null | grep -B 1 -E "^\+.*( as [A-Z]| as$)" | grep -v " as const" || true)

  if [ -n "$ASSERTIONS_WITH_CONTEXT" ]; then
    # Check each assertion pair (previous line + assertion line)
    while IFS= read -r line; do
      # Skip separator lines
      if [ "$line" = "--" ]; then
        continue
      fi

      # If this line has an assertion
            if echo "$line" | grep -qE "^\+.*( as [A-Z]| as$)"; then
                # Allow inline documentation on the same line as the assertion.
                if echo "$line" | grep -qE "//.*(Type assertion|Cast|SAFETY|Validated by schema)"; then
                    PREV_HAS_COMMENT=""
                    continue
                fi
        # Check if we have a comment marker from previous iteration
        if [ -z "$PREV_HAS_COMMENT" ]; then
          # No comment on previous line, this is a violation
          TYPE_ASSERTIONS="$TYPE_ASSERTIONS$line"$'\n'
        fi
        PREV_HAS_COMMENT=""
      # Check if this is a comment line (will apply to next assertion)
      elif echo "$line" | grep -qE "^\+.*//.*(Type assertion|Cast|SAFETY|Validated by schema)"; then
        PREV_HAS_COMMENT="yes"
      else
        PREV_HAS_COMMENT=""
      fi
    done <<< "$ASSERTIONS_WITH_CONTEXT"
  fi
done

TYPE_ASSERTIONS=$(echo "$TYPE_ASSERTIONS" | grep -v "^$" || true)

if [ -n "$TYPE_ASSERTIONS" ]; then
    echo -e "${YELLOW}⚠ WARNING 14: Type assertions without documentation detected${NC}"
    echo "  ${YELLOW}RISK:${NC} Undocumented type assertions hide potential type safety issues"
    echo ""
    echo "  ${CYAN}VIOLATIONS FOUND (first 5):${NC}"
    echo "$TYPE_ASSERTIONS" | head -5 | sed 's/^/    /'
    echo ""
    echo "  ${CYAN}FIX:${NC} Add comment explaining why type assertion is safe"
    echo "  ${CYAN}RECOMMENDED COMMENT FORMATS:${NC}"
    echo "    // Type assertion: <reason>"
    echo "    // Cast needed: <reason>"
    echo "    // SAFETY: <reason>"
    echo "    // Validated by schema: <schema_name>"
    echo ""
    echo "  ${CYAN}EXAMPLE:${NC}"
    echo "    ❌ const data = result as ProductData;"
    echo ""
    echo "    ✅ // Type assertion: Drizzle returns unknown for JSON fields, validated by schema"
    echo "    ✅ const data = result as ProductData;"
    echo ""
    echo "    ✅ // SAFETY: Response validated by productSchema.parse() above"
    echo "    ✅ const product = apiResponse as Product;"
    echo ""
    echo "  ${CYAN}ALTERNATIVES TO TYPE ASSERTIONS:${NC}"
    echo "    • Use type guards: if (isProductData(result)) { ... }"
    echo "    • Use Zod schema: productDataSchema.parse(result)"
    echo "    • Use 'as const' for literal types (automatically allowed)"
    echo ""
    echo "  ${CYAN}DOCS:${NC} docs/01_TYPESCRIPT_PATTERNS.md#type-assertions"
    echo ""
    WARNINGS=$((WARNINGS + 1))
fi

# WARNING 15: Return type consistency - null vs undefined (Phase 3 - Type Safety)
echo "📦 Checking storage/service return type consistency..."
UNDEFINED_RETURNS=$(grep -rn "| undefined" server/storage*.ts server/storage/ server/services/ --include="*.ts" 2>/dev/null | \
  grep "Promise<" | \
  grep -v "options\|config\|params\|args\|props" | \
  grep -v " \* \| //" || true)

if [ -n "$UNDEFINED_RETURNS" ]; then
    echo -e "${YELLOW}⚠ WARNING 15: Storage/service methods returning | undefined (should use | null)${NC}"
    echo "  ${YELLOW}RISK:${NC} Inconsistent return types make null checks harder to maintain"
    echo ""
    echo "  ${CYAN}VIOLATIONS FOUND (first 5):${NC}"
    echo "$UNDEFINED_RETURNS" | head -5 | sed 's/^/    /'
    echo ""
    echo "  ${CYAN}FIX:${NC} Use | null for database 'not found' and data layer scenarios"
    echo "  ${CYAN}CONVENTION:${NC}"
    echo "    • Use 'null' for database queries that may return no results"
    echo "    • Use 'null' for service methods that interact with data layer"
    echo "    • Use 'undefined' for optional function parameters/config only"
    echo ""
    echo "  ${CYAN}EXAMPLE:${NC}"
    echo "    ❌ async getProductById(id: number): Promise<Product | undefined>"
    echo "    ✅ async getProductById(id: number): Promise<Product | null>"
    echo ""
    echo "  ${CYAN}WHY:${NC} SQL returns NULL for missing records, TypeScript should mirror this"
    echo "  ${CYAN}SCOPE:${NC} Applies to storage layer AND services that interact with data"
    echo "  ${CYAN}DOCS:${NC} docs/02_DATABASE_PATTERNS.md#null-vs-undefined-consistency"
    echo ""
    WARNINGS=$((WARNINGS + 1))
fi

# WARNING 16: Storage layer architecture (Phase 4 - Architecture Enforcement)
echo "🏗️  Checking storage layer architecture..."
DIRECT_DB=$(grep -rn "from ['\"].*\/db['\"]" server/services/ --include="*.ts" 2>/dev/null | \
  grep -v "price-aggregation-service" | \
  grep -v "__tests__" | \
  grep -v "\.test\." || true)

if [ -n "$DIRECT_DB" ]; then
    echo -e "${YELLOW}⚠ WARNING 16: Services importing db directly (should use storage layer)${NC}"
    echo "  ${YELLOW}RISK:${NC} Bypassing storage layer reduces maintainability and testability"
    echo ""
    echo "  ${CYAN}VIOLATIONS FOUND (first 5):${NC}"
    echo "$DIRECT_DB" | head -5 | sed 's/^/    /'
    echo ""
    echo "  ${CYAN}FIX:${NC} Import storage abstraction instead of direct db access"
    echo "  ${CYAN}EXAMPLE:${NC}"
    echo "    ❌ import { db } from '../db';"
    echo "    ✅ import { storage } from '../storage';"
    echo ""
    echo "  ${CYAN}WHY:${NC} Storage layer provides:"
    echo "    • Consistent data access patterns"
    echo "    • Easier testing (can mock storage interface)"
    echo "    • Single place to update query logic"
    echo "    • Better separation of concerns"
    echo ""
    echo "  ${CYAN}DOCUMENTED EXCEPTION:${NC} price-aggregation-service.ts (complex transaction context passing)"
    echo "  ${CYAN}DOCS:${NC} docs/02_DATABASE_PATTERNS.md#storage-layer-architecture"
    echo ""
    WARNINGS=$((WARNINGS + 1))
fi

# WARNING 17: Middleware order validation (Phase 4 - Architecture Enforcement)
echo "🔧 Checking middleware order patterns..."
AUTH_BEFORE_CSRF=$(echo "$TS_FILES" | grep "routes/" | xargs git diff --cached 2>/dev/null | grep -E "^\+" | grep -E "withAuth.*csrfProtection|requireAuth.*csrfProtection" || true)

if [ -n "$AUTH_BEFORE_CSRF" ]; then
    echo -e "${YELLOW}⚠ WARNING 17: Auth middleware before CSRF detected (should be CSRF first)${NC}"
    echo "  ${YELLOW}RISK:${NC} Incorrect middleware order can cause performance issues"
    echo ""
    echo "  ${CYAN}VIOLATIONS FOUND:${NC}"
    echo "$AUTH_BEFORE_CSRF" | head -3 | sed 's/^/    /'
    echo ""
    echo "  ${CYAN}FIX:${NC} Apply CSRF protection before authentication"
    echo "  ${CYAN}CORRECT ORDER:${NC}"
    echo "    app.post('/api/resource', csrfProtection, withAuth(handler))"
    echo ""
    echo "  ${CYAN}WHY:${NC}"
    echo "    • CSRF check is fast (token validation)"
    echo "    • Auth check may hit database/session store"
    echo "    • Fail fast with CSRF before expensive auth operations"
    echo ""
    echo "  ${CYAN}EXAMPLE - Before (Wrong):${NC}"
    echo "    app.post('/api/products', withAuth(csrfProtection(handler)))"
    echo ""
    echo "  ${CYAN}EXAMPLE - After (Correct):${NC}"
    echo "    app.post('/api/products', csrfProtection, withAuth(handler))"
    echo ""
    echo "  ${CYAN}DOCS:${NC} CLAUDE.md#middleware-pipeline-order"
    echo ""
    WARNINGS=$((WARNINGS + 1))
fi

# WARNING 18: Test cleanup pattern (Phase 5 - Test Quality Enforcement)
echo "🧹 Checking test cleanup patterns..."
# Find test files with db.delete, then check if they appear in cleanup hooks
# NOTE: Conservative detection - flags any db.delete() in files with cleanup hooks
# May have false positives for tests validating delete() functionality
# Add comment "// Testing delete functionality" to bypass if intentional
TEST_DELETE=""
for file in $(find server/ -name "*.test.ts" 2>/dev/null); do
  # Check if file has both db.delete AND cleanup hooks
  if grep -q "await db\.delete\|db\.delete(" "$file" 2>/dev/null && \
     grep -q "beforeEach\|afterEach\|beforeAll\|afterAll" "$file" 2>/dev/null; then
    # Get the actual violations (excluding lines with bypass comment)
    VIOLATIONS=$(grep -n "await db\.delete\|db\.delete(" "$file" 2>/dev/null | \
      grep -v "Testing delete functionality" | \
      head -3)
    if [ -n "$VIOLATIONS" ]; then
      TEST_DELETE="$TEST_DELETE$VIOLATIONS"$'\n'
    fi
  fi
done
TEST_DELETE=$(echo "$TEST_DELETE" | grep -v "^$" || true)

if [ -n "$TEST_DELETE" ]; then
    echo -e "${YELLOW}⚠ WARNING 18: Test cleanup using db.delete() detected${NC}"
    echo "  ${YELLOW}RISK:${NC} Slow cleanup, cascade issues, and incomplete data removal"
    echo ""
    echo "  ${CYAN}VIOLATIONS FOUND:${NC}"
    echo "$TEST_DELETE" | sed 's/^/    /'
    echo ""
    echo "  ${CYAN}FIX:${NC} Use TRUNCATE CASCADE for fast, complete cleanup"
    echo "  ${CYAN}RECOMMENDED PATTERN:${NC}"
    echo "    afterEach(async () => {"
    echo "      await db.execute(sql\`TRUNCATE TABLE products RESTART IDENTITY CASCADE\`);"
    echo "    });"
    echo ""
    echo "  ${CYAN}WHY TRUNCATE CASCADE:${NC}"
    echo "    • Faster - resets entire table vs deleting row-by-row"
    echo "    • Complete - CASCADE removes related records automatically"
    echo "    • Clean - RESTART IDENTITY resets auto-increment counters"
    echo "    • Reliable - No orphaned foreign key references"
    echo ""
    echo "  ${CYAN}EXAMPLE - Before (Slow):${NC}"
    echo "    await db.delete(products);"
    echo "    await db.delete(productOffers);"
    echo ""
    echo "  ${CYAN}EXAMPLE - After (Fast):${NC}"
    echo "    await db.execute(sql\`TRUNCATE TABLE products RESTART IDENTITY CASCADE\`);"
    echo ""
    echo "  ${CYAN}BYPASS (if testing delete functionality):${NC}"
    echo "    await db.delete(users).where(eq(users.id, 1)); // Testing delete functionality"
    echo ""
    echo "  ${CYAN}DOCS:${NC} docs/02_DATABASE_PATTERNS.md#test-database-cleanup"
    echo ""
    WARNINGS=$((WARNINGS + 1))
fi

# WARNING 19: Test data type safety (Phase 5 - Test Quality Enforcement)
echo "📊 Checking test data type safety..."
# Look for field assignments with string-wrapped integers (amount: "1500")
# NOTE: DECIMAL columns (e.g. price/targetPrice) are represented as strings in Drizzle/Postgres.
STRING_NUMBERS=$(grep -rnE "(amount)[[:space:]]*:[[:space:]]*['\"][0-9]" server/ --include="*.test.ts" 2>/dev/null | \
  grep -v "priceString\|formatted" | \
  head -5 || true)

if [ -n "$STRING_NUMBERS" ]; then
    echo -e "${YELLOW}⚠ WARNING 19: String numbers in test data detected${NC}"
    echo "  ${YELLOW}RISK:${NC} Type mismatches cause Zod validation failures and confusing test errors"
    echo ""
    echo "  ${CYAN}VIOLATIONS FOUND:${NC}"
    echo "$STRING_NUMBERS" | sed 's/^/    /'
    echo ""
    echo "  ${CYAN}FIX:${NC} Use actual numbers, not strings, for numeric fields"
    echo "  ${CYAN}CORRECT TYPES:${NC}"
    echo "    • amount: Use 1500 (not \"1500\")"
    echo ""
    echo "  ${CYAN}WHY PROPER TYPES:${NC}"
    echo "    • Zod schemas validate types strictly"
    echo "    • Database expects numeric types for DECIMAL/INTEGER columns"
    echo "    • String numbers cause silent conversion issues"
    echo "    • Tests should match production data types"
    echo ""
    echo "  ${CYAN}EXAMPLE - Before (Wrong):${NC}"
    echo "    const testProduct = {"
    echo "      name: 'iPhone 15',"
    echo "      price: \"999.99\"  // ❌ String"
    echo "    };"
    echo ""
    echo "  ${CYAN}EXAMPLE - After (Correct):${NC}"
    echo "    const testProduct = {"
    echo "      name: 'iPhone 15',"
    echo "      price: 999.99  // ✅ Number"
    echo "    };"
    echo ""
    echo "  ${CYAN}DOCS:${NC} docs/02_DATABASE_PATTERNS.md#test-data-type-safety"
    echo ""
    WARNINGS=$((WARNINGS + 1))
fi

# ============================================================================
# INFORMATIONAL (Tracking only, no action required)
# ============================================================================

# INFO: Track TODO/FIXME comments (helps measure technical debt)
NEW_TODOS=$(echo "$TS_FILES" | xargs git diff --cached 2>/dev/null | grep -E "^\+" | grep -iE "TODO|FIXME" | wc -l | tr -d ' ')
if [ "$NEW_TODOS" -gt 0 ]; then
    echo -e "${CYAN}ℹ INFO: $NEW_TODOS new TODO/FIXME comment(s) added${NC}"
    echo "  ${CYAN}NOTE:${NC} TODOs are tracked for technical debt management"
    echo ""
fi

# ============================================================================
# SECTION 3: Test Files Detection
# ============================================================================
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
if echo "$STAGED_FILES" | grep -E "(test|spec)\." >/dev/null 2>&1; then
    echo -e "${BLUE}▶${NC} Test files detected - recommending test run..."
    echo -e "${YELLOW}ℹ${NC}  Run 'npm test' to verify your changes don't break existing tests"
    echo ""
fi

# ============================================================================
# SECTION 4: Final Summary
# ============================================================================
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
if [ $SECURITY_ISSUES -eq 0 ]; then
    echo -e "${GREEN}✓ All critical checks passed!${NC}"
    echo ""
    echo "📋 BLOCKERS enforced (commit will fail if found):"
    echo "  ✓ No TypeScript errors"
    echo "  ✓ No ESLint errors (any types, unsafe operations)"
    echo "  ✓ No passwordHash exposure"
    echo "  ✓ No 'any' types in new code"
    echo "  ✓ No console.log in production code"
    echo "  ✓ No N+1 query patterns (queries in loops)"
    echo "  ✓ No foreign keys without cascade rules"
    echo "  ✓ No timestamps without timezone"
    echo "  ✓ No hardcoded secrets/API keys"
    echo "  ✓ No SQL injection vulnerabilities"
    echo "  ✓ No route registration order issues"
    echo "  ✓ No unsafe parseInt() usage"
    echo "  ✓ No global CSRF middleware (anti-pattern)"
    echo "  ✓ No mutations without CSRF protection"

    if [ $WARNINGS -gt 0 ]; then
        echo ""
        echo -e "${YELLOW}⚠ ${WARNINGS} warning(s) detected - review recommended:${NC}"
        echo "  • Missing transaction boundaries (data integrity)"
        echo "  • Missing input validation (data quality)"
        echo "  • Missing authentication checks (access control)"
        echo "  • Missing error handling (stability)"
        echo "  • Direct db imports in routes (architecture)"
        echo "  • Hardcoded colors (design consistency)"
        echo "  • Missing error sanitization (security)"
        echo "  • Unoptimized queries (performance)"
        echo "  • Client-side data aggregation (performance)"
        echo "  • Background jobs without rate limiting (safety)"
        echo "  • Check-then-act without SERIALIZABLE isolation (race conditions)"
        echo "  • Hardcoded password lengths (security consistency)"
        echo "  • Hardcoded bcrypt rounds (security consistency)"
        echo "  • Type assertions without documentation (type safety)"
        echo "  • Return type inconsistency - null vs undefined (maintainability)"
        echo "  • Services importing db directly (architecture - use storage layer)"
        echo "  • Auth middleware before CSRF (middleware order - CSRF should be first)"
        echo ""
        echo "  ${CYAN}TIP:${NC} While warnings don't block commits, addressing them improves code quality"
    fi
    echo ""
    echo -e "${GREEN}✅ Proceeding with commit...${NC}"
    exit 0
else
    echo -e "${RED}✗ COMMIT BLOCKED - ${SECURITY_ISSUES} CRITICAL ISSUE(S) FOUND!${NC}"
    echo ""
    echo "🚫 Your commit violates mandatory security/quality standards."
    echo ""
    echo "Quick fixes:"
    echo "  ${CYAN}TypeScript errors${NC} → Run 'npm run check' and fix all type errors"
    echo "  ${CYAN}any types${NC} → Use proper TypeScript types (string, number, MyInterface)"
    echo "  ${CYAN}console.log${NC} → Use log() from utils/logger or remove"
    echo "  ${CYAN}N+1 queries${NC} → Use JOINs, inArray(), or array_agg()"
    echo "  ${CYAN}passwordHash${NC} → Never expose in database queries"
    echo "  ${CYAN}Foreign keys${NC} → Add onDelete: 'cascade' | 'set null' | 'restrict'"
    echo "  ${CYAN}Secrets${NC} → Use process.env.SECRET_NAME, never hardcode"
    echo "  ${CYAN}SQL injection${NC} → Use Drizzle ORM methods, not template literals"
    echo ""
    echo "📚 Documentation:"
    echo "  • Database patterns: docs/DATABASE_PATTERNS.md"
    echo "  • Security patterns: docs/SECURITY_PATTERNS.md"
    echo "  • TypeScript patterns: docs/TYPESCRIPT_PATTERNS.md"
    echo ""
    echo "⚠️  To bypass (NOT RECOMMENDED): git commit --no-verify"
    echo ""
    exit 1
fi
