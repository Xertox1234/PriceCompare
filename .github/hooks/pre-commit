#!/bin/bash

# PriceCompare Pre-Commit Hook - Enhanced Edition with TypeScript Check
# Automated code review checks before committing changes
#
# This hook enforces critical security and quality standards:
# - BLOCKERS: Security vulnerabilities, type safety violations, data integrity issues
# - WARNINGS: Code quality improvements, best practice violations
#
# Version: 3.5.0 (Phase 5 Complete + UTC Timezone Detection: Pattern 7 added for server-side date handling)

set -e

# Optional debug tracing (helps diagnose perceived "hangs" in long-running commands).
# Usage: PRECOMMIT_TRACE=1 git commit ...
if [ "${PRECOMMIT_TRACE:-0}" = "1" ]; then
    export PS4='+[${BASH_SOURCE##*/}:${LINENO}] '
    set -x
fi

echo "🔍 Running pre-commit code review checks..."
echo ""

# Colors for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Track if any checks fail
CHECKS_FAILED=0
SECURITY_ISSUES=0
WARNINGS=0

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# Check if there are any TypeScript/JavaScript files staged
TS_FILES=$(echo "$STAGED_FILES" | grep -E '\.(ts|tsx|js|jsx)$' || true)

if [ -z "$TS_FILES" ]; then
    echo -e "${GREEN}✓${NC} No TypeScript/JavaScript files changed, skipping checks"
    exit 0
fi

echo -e "${YELLOW}Staged files to review:${NC}"
echo "$TS_FILES" | sed 's/^/  - /'
echo ""

# ============================================================================
# SECTION 1: TypeScript Type Checking (MANDATORY - BLOCKS COMMIT)
# ============================================================================
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo -e "${BLUE}▶${NC} TypeScript type check (full codebase)..."
echo -e "${YELLOW}ℹ${NC}  Running 'npm run check' - all type errors must be fixed before commit"
echo -e "${YELLOW}ℹ${NC}  (If this looks stuck, it's usually just running silently)"

# Run type check and block commit if errors found
if npm run check >/dev/null 2>&1; then
    echo -e "${GREEN}✓${NC} No TypeScript errors detected"
else
    echo -e "${RED}✗ BLOCKER: TypeScript errors detected in codebase${NC}"
    echo ""
    echo "  ${RED}RISK:${NC} Type errors can hide bugs and cause runtime failures"
    echo "  ${CYAN}ACTION:${NC} Fix all TypeScript errors before committing:"
    echo ""
    npm run check 2>&1 | grep "error TS" | head -20
    echo ""
    if [ $(npm run check 2>&1 | grep -c "error TS") -gt 20 ]; then
        echo "  ... and $(($(npm run check 2>&1 | grep -c "error TS") - 20)) more errors"
        echo ""
    fi
    echo "  ${CYAN}TIP:${NC} Run 'npm run check' to see all errors with file paths"
    echo ""
    SECURITY_ISSUES=1
fi
echo ""

# ============================================================================
# Proactive Lint Pattern Detection (Fast checks before full lint)
# ============================================================================
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo -e "${BLUE}▶${NC} Proactive lint pattern detection..."
echo -e "${YELLOW}ℹ${NC}  Checking for common patterns that cause lint failures"
echo ""

# Get diff of staged changes (only new/modified lines)
STAGED_DIFF=$(echo "$TS_FILES" | xargs git diff --cached 2>/dev/null || echo "")

# Pattern 1: Floating Promises (React Query invalidation, service calls)
FLOATING_PROMISES=$(echo "$STAGED_DIFF" | grep -E "^\+" | grep -E "queryClient\.invalidateQueries|Service\.[a-z]+\(|emailService\.|notificationService\." | grep -v "await " | grep -v "void " | wc -l | tr -d ' ')
if [ "$FLOATING_PROMISES" != "0" ]; then
    echo -e "${YELLOW}⚠ Pattern 1: Potential floating promises detected ($FLOATING_PROMISES instances)${NC}"
    echo "  ${CYAN}QUICK FIX:${NC} Add 'void' prefix for fire-and-forget operations"
    echo "  ${CYAN}EXAMPLE:${NC}"
    echo "    ❌ queryClient.invalidateQueries({ queryKey: [...] });"
    echo "    ✅ void queryClient.invalidateQueries({ queryKey: [...] });"
    echo "    ✅ await emailService.send(...);  // If you need to wait"
    echo ""
fi

# Pattern 2: Misused Promises in Event Handlers (async in onClick without wrapper)
MISUSED_PROMISES=$(echo "$STAGED_DIFF" | grep -E "^\+" | grep -E "onClick.*=.*async|onSubmit.*=.*async" | grep -v "void " | wc -l | tr -d ' ')
if [ "$MISUSED_PROMISES" != "0" ]; then
    echo -e "${YELLOW}⚠ Pattern 2: Async event handlers without void wrapper ($MISUSED_PROMISES instances)${NC}"
    echo "  ${CYAN}QUICK FIX:${NC} Wrap async handlers with void IIFE or arrow function"
    echo "  ${CYAN}EXAMPLE:${NC}"
    echo "    ❌ onClick={handleSubmit}  // async function"
    echo "    ✅ onClick={() => void handleSubmit()}"
    echo "    ✅ onClick={async () => { await handleSubmit(); }}"
    echo ""
fi

# Pattern 3: Explicit 'any' types in new code
EXPLICIT_ANY=$(echo "$STAGED_DIFF" | grep -E "^\+" | grep -E ":\s*any[^a-zA-Z]|\sany\s*=" | grep -v "eslint-disable" | grep -v "// eslint" | wc -l | tr -d ' ')
if [ "$EXPLICIT_ANY" != "0" ]; then
    echo -e "${YELLOW}⚠ Pattern 3: Explicit 'any' types detected ($EXPLICIT_ANY instances)${NC}"
    echo "  ${CYAN}QUICK FIX:${NC} Replace with proper types from @shared/schema"
    echo "  ${CYAN}EXAMPLE:${NC}"
    echo "    ❌ const data: any = await fetch(...);"
    echo "    ✅ const data: Product = await fetch(...);"
    echo "    ✅ const data: unknown = await fetch(...); // Then type guard"
    echo ""
fi

# Pattern 4: Missing await before async operations
MISSING_AWAIT=$(echo "$STAGED_DIFF" | grep -E "^\+" | grep -E "= (fetch|db\.(select|insert|update|delete)|storage\.[a-z]+)\(" | grep -v "await " | grep -v "void " | wc -l | tr -d ' ')
if [ "$MISSING_AWAIT" != "0" ]; then
    echo -e "${YELLOW}⚠ Pattern 4: Async operations without await ($MISSING_AWAIT instances)${NC}"
    echo "  ${CYAN}QUICK FIX:${NC} Add 'await' keyword before async calls"
    echo "  ${CYAN}EXAMPLE:${NC}"
    echo "    ❌ const result = db.select().from(users);"
    echo "    ✅ const result = await db.select().from(users);"
    echo "    ✅ void db.insert(logs).values({...});  // Fire-and-forget"
    echo ""
fi

# Pattern 5: Unused variables (common after refactoring)
UNUSED_VARS=$(echo "$STAGED_DIFF" | grep -E "^\+" | grep -E "^(const|let|var) [a-z]+ =" | wc -l | tr -d ' ')
# Only warn if there are many new variable declarations
if [ "$UNUSED_VARS" -gt 10 ]; then
    echo -e "${YELLOW}⚠ Pattern 5: Many new variables declared ($UNUSED_VARS) - check for unused vars${NC}"
    echo "  ${CYAN}QUICK CHECK:${NC} Run 'npx eslint --fix <file>' to remove unused variables"
    echo ""
fi

# Pattern 6: console.log in non-test files
CONSOLE_LOGS=$(echo "$TS_FILES" | grep -v "test\|spec\|__tests__" | xargs git diff --cached 2>/dev/null | grep -E "^\+" | grep "console\.log" | wc -l | tr -d ' ')
if [ "$CONSOLE_LOGS" != "0" ]; then
    echo -e "${YELLOW}⚠ Pattern 6: console.log in production code ($CONSOLE_LOGS instances)${NC}"
    echo "  ${CYAN}QUICK FIX:${NC} Replace with structured logger"
    echo "  ${CYAN}EXAMPLE:${NC}"
    echo "    ❌ console.log('User created', user);"
    echo "    ✅ import { createLogger } from '@/utils/logger';"
    echo "    ✅ const log = createLogger('ModuleName');"
    echo "    ✅ log.info('User created', { userId: user.id });"
    echo ""
fi

# Pattern 7: Local timezone date methods in server code (NEW - 2025-12-09)
# Detects local timezone Date methods that should use UTC equivalents
# See: docs/LEARNINGS_TODO_179_UTC_TIMEZONE_SERVICE_FIX.md
SERVER_FILES=$(echo "$TS_FILES" | grep "^server/" | grep -v "test\|spec\|__tests__" || true)
if [ -n "$SERVER_FILES" ]; then
    # Check for local timezone Date constructor: new Date(year, month, day)
    LOCAL_DATE_CONSTRUCTOR=$(echo "$SERVER_FILES" | xargs git diff --cached 2>/dev/null | grep -E "^\+" | grep -E "new Date\([0-9]+,\s*[0-9]+" | grep -v "Date.UTC" | grep -v "// UTC:" | wc -l | tr -d ' ')

    # Check for local timezone getters: .getFullYear(), .getMonth(), .getDate()
    LOCAL_GETTERS=$(echo "$SERVER_FILES" | xargs git diff --cached 2>/dev/null | grep -E "^\+" | grep -E "\.(getFullYear|getMonth|getDate)\(" | grep -v "getUTC" | grep -v "// UTC:" | wc -l | tr -d ' ')

    # Check for local timezone setters: .setDate(), .setHours(), .setMinutes()
    LOCAL_SETTERS=$(echo "$SERVER_FILES" | xargs git diff --cached 2>/dev/null | grep -E "^\+" | grep -E "\.(setDate|setHours|setMinutes|setSeconds)\(" | grep -v "setUTC" | grep -v "// UTC:" | wc -l | tr -d ' ')

    TIMEZONE_ISSUES=$((LOCAL_DATE_CONSTRUCTOR + LOCAL_GETTERS + LOCAL_SETTERS))

    if [ "$TIMEZONE_ISSUES" != "0" ]; then
        echo -e "${YELLOW}⚠ Pattern 7: Local timezone date methods in server code ($TIMEZONE_ISSUES instances)${NC}"
        echo "  ${CYAN}RISK:${NC} Tests pass in one timezone but fail in another (e.g., PST vs UTC)"
        echo "  ${CYAN}QUICK FIX:${NC} Use UTC date methods for server-side date handling"
        echo "  ${CYAN}EXAMPLES:${NC}"
        if [ "$LOCAL_DATE_CONSTRUCTOR" != "0" ]; then
            echo "    ❌ new Date(2024, 0, 1)  // Uses local timezone"
            echo "    ✅ new Date(Date.UTC(2024, 0, 1, 0, 0, 0))  // Explicit UTC"
        fi
        if [ "$LOCAL_GETTERS" != "0" ]; then
            echo "    ❌ date.getFullYear(), date.getMonth(), date.getDate()"
            echo "    ✅ date.getUTCFullYear(), date.getUTCMonth(), date.getUTCDate()"
        fi
        if [ "$LOCAL_SETTERS" != "0" ]; then
            echo "    ❌ date.setDate(date.getDate() + 1)"
            echo "    ✅ date.setUTCDate(date.getUTCDate() + 1)"
        fi
        echo "  ${CYAN}BYPASS:${NC} Add '// UTC:' comment if local timezone is intentional"
        echo "  ${CYAN}DOCS:${NC} See docs/LEARNINGS_TODO_179_UTC_TIMEZONE_SERVICE_FIX.md"
        echo ""
    fi
else
    TIMEZONE_ISSUES=0
fi

# Summary
TOTAL_PATTERN_WARNINGS=$((FLOATING_PROMISES + MISUSED_PROMISES + EXPLICIT_ANY + MISSING_AWAIT + CONSOLE_LOGS + TIMEZONE_ISSUES))
if [ "$TOTAL_PATTERN_WARNINGS" = "0" ]; then
    echo -e "${GREEN}✓${NC} No common lint patterns detected"
else
    echo -e "${YELLOW}⚠ Total: $TOTAL_PATTERN_WARNINGS potential lint issues detected${NC}"
    echo "  ${CYAN}TIP:${NC} Fix these patterns now to avoid ESLint errors"
fi
echo ""

# ============================================================================
# ESLint Check (MANDATORY - BLOCKS COMMIT)
# ============================================================================
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo -e "${BLUE}▶${NC} ESLint type safety check..."
echo -e "${YELLOW}ℹ${NC}  Checking for 'any' types and unsafe operations"

TS_FILE_COUNT=$(echo "$TS_FILES" | wc -l | tr -d ' ')
echo -e "${YELLOW}ℹ${NC}  Running ESLint on $TS_FILE_COUNT staged file(s)..."

# Run ESLint on staged TypeScript files
ESLINT_OUTPUT=$(echo "$TS_FILES" | xargs npx eslint --quiet 2>&1 || true)

if [ -z "$ESLINT_OUTPUT" ]; then
    echo -e "${GREEN}✓${NC} No ESLint errors detected"
else
    echo -e "${RED}✗ BLOCKER: ESLint errors detected${NC}"
    echo ""
    echo "  ${RED}RISK:${NC} 'any' types defeat TypeScript safety, unsafe operations hide bugs"
    echo "  ${CYAN}ACTION:${NC} Fix ESLint errors:"
    echo ""
    echo "$ESLINT_OUTPUT" | grep -E "(error|@typescript-eslint)" | head -20
    echo ""
    if [ $(echo "$ESLINT_OUTPUT" | grep -c "error") -gt 20 ]; then
        echo "  ... and $(($(echo "$ESLINT_OUTPUT" | grep -c "error") - 20)) more errors"
        echo ""
    fi
    echo "  ${CYAN}COMMON FIXES:${NC}"
    echo "    • Replace 'any' with proper types from @shared/schema"
    echo "    • Use 'unknown' for truly unknown types + type guards"
    echo "    • Import types: import { type Product } from '@shared/schema'"
    echo ""
    echo "  ${CYAN}TIP:${NC} Run 'npx eslint <file>' for detailed error messages"
    echo ""
    SECURITY_ISSUES=1
fi
echo ""

# ============================================================================
# SECTION 2: Security and Code Quality Checks
# ============================================================================
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo -e "${BLUE}▶${NC} Security and code quality checks..."
echo ""

# Get the diff for checks (code files only)
CODE_DIFF_OUTPUT=$(echo "$TS_FILES" | xargs git diff --cached 2>/dev/null || echo "")

# ============================================================================
# CRITICAL BLOCKERS (Will fail commit if found)
# ============================================================================

# BLOCKER 1: Password hash exposure (CRITICAL - data breach risk)
# Exclude scripts/ directory (dev-only utilities that legitimately set passwordHash)
SERVER_CODE_DIFF=$(echo "$TS_FILES" | grep -v "^scripts/" | xargs git diff --cached 2>/dev/null || echo "")
if echo "$SERVER_CODE_DIFF" | grep -E "^\+" | grep -i "passwordHash" | grep -v "NEVER" | grep -v "SECURITY:" | grep -v "//" >/dev/null 2>&1; then
    echo -e "${RED}✗ BLOCKER 1: Potential passwordHash exposure detected${NC}"
    echo "  ${RED}RISK:${NC} Exposing password hashes can lead to credential theft"
    echo "  ${CYAN}FIX:${NC} Use explicit field selection and exclude passwordHash"
    echo "  ${CYAN}EXAMPLE:${NC} db.select({ id: users.id, email: users.email }) // Don't include passwordHash"
    echo ""
    SECURITY_ISSUES=1
fi

# BLOCKER 2: console.log in production code (CRITICAL - info leak)
if echo "$STAGED_FILES" | grep -v "test" | grep -v "spec" | xargs git diff --cached 2>/dev/null | grep -E "^\+" | grep "console\.(log|debug)" >/dev/null 2>&1; then
    echo -e "${RED}✗ BLOCKER 2: console.log detected in non-test code${NC}"
    echo "  ${RED}RISK:${NC} Console output can leak sensitive data in production"
    echo "  ${CYAN}FIX:${NC} Use structured logger: import { createLogger } from './utils/logger'"
    echo "  ${CYAN}EXAMPLE:${NC} const log = createLogger('ModuleName'); log.info('message', { data })"
    echo ""
    SECURITY_ISSUES=1
fi

# BLOCKER 3: 'any' types in new code (CRITICAL - defeats type safety)
if echo "$TS_FILES" | xargs git diff --cached 2>/dev/null | grep -E "^\+" | grep -E ":\s*any[^a-zA-Z]" >/dev/null 2>&1; then
    echo -e "${RED}✗ BLOCKER 3: 'any' types detected in new code${NC}"
    echo "  ${RED}RISK:${NC} Defeats TypeScript type safety and hides bugs"
    echo "  ${CYAN}FIX:${NC} Use proper TypeScript types (string, number, MyInterface, etc.)"
    echo "  ${CYAN}EXAMPLE:${NC} const data: UserData = {...} // Not: const data: any = {...}"
    echo ""
    SECURITY_ISSUES=1
fi

# BLOCKER 4: N+1 query patterns (CRITICAL - performance killer)
# Enhanced detection: Check for database queries within 5 lines of loop constructs
N1_PATTERN_FOUND=0
if echo "$STAGED_FILES" | grep -E "\.(ts|js)$" | grep -v "__tests__" | grep -v "\.test\." >/dev/null 2>&1; then
    # Search for await db. or await tx. calls near loop constructs
    N1_PATTERNS=$(echo "$TS_FILES" | grep -v "__tests__" | grep -v "\.test\." | xargs git diff --cached 2>/dev/null | grep -E "^\+" | grep -B5 -A5 "await (db|tx|storage)\." | grep -E "(for\s*\(|\.forEach\(|\.map\(async|while\s*\()" | grep -v "// N+1 safe:" | head -3)

    if [ -n "$N1_PATTERNS" ]; then
        N1_PATTERN_FOUND=1
    fi
fi

if [ $N1_PATTERN_FOUND -eq 1 ]; then
    echo -e "${RED}✗ BLOCKER 4: Potential N+1 query pattern detected${NC}"
    echo "  ${RED}RISK:${NC} Queries in loops cause severe performance degradation (100 items = 100 queries)"
    echo ""
    echo "  ${CYAN}PATTERN FOUND:${NC}"
    echo "$N1_PATTERNS" | sed 's/^/    /'
    echo ""
    echo "  ${CYAN}FIX OPTIONS:${NC}"
    echo "    1. Use JOINs:    db.select().leftJoin(related, eq(table.id, related.tableId))"
    echo "    2. Use inArray(): db.select().where(inArray(users.id, arrayOfIds))"
    echo "    3. Use array_agg(): Aggregate in SQL instead of multiple queries"
    echo ""
    echo "  ${CYAN}EXAMPLE - Before (N+1):${NC}"
    echo "    for (const product of products) {"
    echo "      const offers = await db.select().from(offers).where(eq(offers.productId, product.id));"
    echo "    }"
    echo ""
    echo "  ${CYAN}EXAMPLE - After (Fixed):${NC}"
    echo "    const productIds = products.map(p => p.id);"
    echo "    const allOffers = await db.select().from(offers).where(inArray(offers.productId, productIds));"
    echo ""
    echo "  ${CYAN}EXEMPTION:${NC} If intentional sequential processing:"
    echo "    // N+1 safe: Rate-limited API calls, intentional sequential processing"
    echo "    for (const item of items) { await processOne(item); }"
    echo ""
    echo "  ${CYAN}DOCS:${NC} docs/02_DATABASE_PATTERNS.md#n1-query-pattern"
    echo ""
    SECURITY_ISSUES=1
fi

# BLOCKER 5: Foreign key without cascade rule (CRITICAL - data integrity)
if echo "$STAGED_FILES" | grep "schema.ts" | xargs git diff --cached 2>/dev/null | grep -E "^\+" | grep -F ".references(" | grep -v "onDelete:" >/dev/null 2>&1; then
    echo -e "${RED}✗ BLOCKER 5: Foreign key without cascade rule detected${NC}"
    echo "  ${RED}RISK:${NC} Can cause orphaned records and data integrity violations"
    echo "  ${CYAN}FIX:${NC} All foreign keys MUST specify onDelete behavior"
    echo "  ${CYAN}EXAMPLE:${NC} .references(() => users.id, { onDelete: 'cascade' })"
    echo "  ${CYAN}OPTIONS:${NC} 'cascade' (delete children) | 'set null' (nullify) | 'restrict' (prevent)"
    echo ""
    SECURITY_ISSUES=1
fi

# BLOCKER 5.5: Timestamp without timezone (CRITICAL - timezone bugs)
if echo "$STAGED_FILES" | grep "schema.ts" | xargs git diff --cached 2>/dev/null | grep -E "^\+" | grep -F "timestamp(" | grep -v "withTimezone: true" >/dev/null 2>&1; then
    echo -e "${RED}✗ BLOCKER 5.5: Timestamp without timezone detected${NC}"
    echo "  ${RED}RISK:${NC} Causes ambiguous timezone handling, expired tokens appear valid/invalid incorrectly"
    echo "  ${CYAN}FIX:${NC} All timestamp columns MUST use timestamptz (with timezone)"
    echo "  ${CYAN}EXAMPLE:${NC} timestamp('expires_at', { withTimezone: true }).notNull()"
    echo "  ${CYAN}WHY:${NC} PostgreSQL 'timestamp' has no timezone metadata, comparisons with NOW() are ambiguous"
    echo "  ${CYAN}IMPACT:${NC} Different behavior in dev (UTC) vs production (non-UTC timezone)"
    echo "  ${CYAN}DOCS:${NC} See docs/02_DATABASE_PATTERNS.md#53-timestamp-vs-timestamptz-critical"
    echo ""
    SECURITY_ISSUES=1
fi

# BLOCKER 6: Hardcoded secrets/API keys (CRITICAL - credential leak)
if echo "$TS_FILES" | xargs git diff --cached 2>/dev/null | grep -E "^\+" | grep -iE "(api_key|apikey|password|secret|token|auth_token|private_key).*=.*['\"][a-zA-Z0-9]{16,}" | grep -v "process.env" | grep -v "import.meta.env" | grep -v "TODO" | grep -v "//" >/dev/null 2>&1; then
    echo -e "${RED}✗ BLOCKER 6: Potential hardcoded secret detected${NC}"
    echo "  ${RED}RISK:${NC} Committing secrets can lead to complete system compromise"
    echo "  ${CYAN}FIX:${NC} Use environment variables for all secrets"
    echo "  ${CYAN}EXAMPLE:${NC} const apiKey = process.env.API_KEY // Not: const apiKey = 'sk-abc123...'"
    echo "  ${CYAN}ACTION:${NC} If secret already committed, rotate it IMMEDIATELY"
    echo ""
    SECURITY_ISSUES=1
fi

# BLOCKER 7: SQL injection vulnerability (CRITICAL - database compromise)
if echo "$TS_FILES" | xargs git diff --cached 2>/dev/null | grep -E "^\+" | grep -E "sql\s*\`.*\$\{.*\}\`" | grep -v "sql<" >/dev/null 2>&1; then
    echo -e "${RED}✗ BLOCKER 7: Potential SQL injection vulnerability${NC}"
    echo "  ${RED}RISK:${NC} Attackers can execute arbitrary SQL queries"
    echo "  ${CYAN}FIX:${NC} Never use template literals with user input in SQL"
    echo "  ${CYAN}EXAMPLE:${NC} db.select().where(eq(users.id, userId)) // Not: sql\`SELECT * WHERE id = \${userId}\`"
    echo ""
    SECURITY_ISSUES=1
fi

# BLOCKER 8: Route registration order (CRITICAL - endpoint 404s)
if echo "$STAGED_FILES" | grep "routes/" | xargs git diff --cached 2>/dev/null | grep -E "^\+" | grep -E "app\.(get|post|put|patch|delete).*/:.*\)" >/dev/null 2>&1; then
    # Check if parameterized route is followed by specific routes in same file
    ROUTE_FILES=$(echo "$STAGED_FILES" | grep "routes/" || true)
    for file in $ROUTE_FILES; do
        if git diff --cached "$file" 2>/dev/null | grep -E "^\+" | grep -E "/:id.*\)" >/dev/null 2>&1; then
            if git diff --cached "$file" 2>/dev/null | grep -A 20 "/:id" | grep -E "^\+" | grep -E "/[a-z]+(stats|products|actions)" >/dev/null 2>&1; then
                echo -e "${RED}✗ BLOCKER 8: Route registration order violation detected${NC}"
                echo "  ${RED}RISK:${NC} Specific routes after :id will never be reached (404 errors)"
                echo "  ${CYAN}FIX:${NC} Register specific routes (/stats, /products) BEFORE parameterized routes (/:id)"
                echo "  ${CYAN}EXAMPLE:${NC} app.get('/api/watchlists/stats', ...); // BEFORE app.get('/api/watchlists/:id', ...);"
                echo "  ${CYAN}RULE:${NC} Routes are matched in order - most specific to least specific"
                echo ""
                SECURITY_ISSUES=1
                break
            fi
        fi
    done
fi

# BLOCKER 9: Unsafe parseInt usage (CRITICAL - validation bypass)
# Enhanced in Phase 3: Focus on request params (req.params, req.query, req.body)
UNSAFE_PARSEINT=$(echo "$TS_FILES" | xargs git diff --cached 2>/dev/null | grep -E "^\+" | grep -E "parseInt\(req\.|Number\(req\." | grep -v "parseIntSafe" | grep -v "parseIntOptional" || true)

if [ -n "$UNSAFE_PARSEINT" ]; then
    echo -e "${RED}✗ BLOCKER 9: Unsafe parseInt() or Number() on request params detected${NC}"
    echo "  ${RED}RISK:${NC} Accepts NaN, negative numbers, and floats without validation"
    echo ""
    echo "  ${CYAN}VIOLATIONS FOUND:${NC}"
    echo "$UNSAFE_PARSEINT" | head -5 | sed 's/^/    /'
    echo ""
    echo "  ${CYAN}FIX:${NC} Use parseIntSafe() or parseIntOptional() from validation-helpers"
    echo "  ${CYAN}EXAMPLES:${NC}"
    echo "    ❌ const id = parseInt(req.params.id);  // Accepts NaN, negative, float"
    echo "    ❌ const limit = Number(req.query.limit);  // No validation"
    echo ""
    echo "    ✅ const id = parseIntSafe(req.params.id, 'userId', { min: 1 });"
    echo "    ✅ const limit = parseIntOptional(req.query.limit, 'limit', { min: 1, max: 100 });"
    echo ""
    echo "  ${CYAN}WHY:${NC} parseInt() and Number() return NaN for invalid input, causing runtime errors"
    echo "  ${CYAN}DOCS:${NC} docs/04_SECURITY_PATTERNS.md#safe-integer-parsing"
    echo ""
    SECURITY_ISSUES=1
fi

# BLOCKER 10: Global CSRF protection (CRITICAL - causes double protection)
if echo "$STAGED_FILES" | grep "server/index.ts" | xargs git diff --cached 2>/dev/null | grep -E "^\+" | grep "app\.use.*csrfProtection" >/dev/null 2>&1; then
    echo -e "${RED}✗ BLOCKER 10: Global CSRF middleware detected (CRITICAL ANTI-PATTERN)${NC}"
    echo "  ${RED}RISK:${NC} Causes double-protection, blocks GET requests, breaks legitimate flows"
    echo "  ${CYAN}FIX:${NC} Remove app.use(csrfProtection) and apply per-route instead"
    echo "  ${CYAN}CORRECT:${NC} app.post('/api/resource', csrfProtection, handler)"
    echo "  ${CYAN}DOCS:${NC} docs/04_SECURITY_PATTERNS.md#csrf-protection"
    echo "  ${CYAN}WHY:${NC} CSRF must be per-route to avoid double-protection in nested routes"
    echo ""
    SECURITY_ISSUES=1
fi

# BLOCKER 11: Missing CSRF on mutations (CRITICAL - CSRF vulnerability)
# NOTE: macOS/BSD grep has different escaping rules than GNU grep and many routes
# are defined across multiple lines. To avoid false positives, scan the staged
# route file contents and look for csrfProtection within the middleware window.
CSRF_VIOLATIONS=""
ROUTE_FILES=$(echo "$STAGED_FILES" | grep -E "^server/routes/.*\.ts$" || true)

for file in $ROUTE_FILES; do
    # Read the staged version of the file (not working tree)
    content=$(git show ":$file" 2>/dev/null || true)
    if [ -z "$content" ]; then
        continue
    fi

    # Find route definitions and inspect the next few lines for csrfProtection
    route_lines=$(echo "$content" | awk '/(app|router)\.(post|put|patch|delete)\(/ { print NR }')
    for ln in $route_lines; do
        snippet=$(echo "$content" | sed -n "${ln},$((ln+10))p")
        route_line=$(echo "$content" | sed -n "${ln}p")

        # Ignore explicit exemptions
        if echo "$snippet" | grep -q "// CSRF exempt:"; then
            continue
        fi

        # Ignore known public endpoints
        if echo "$snippet" | grep -qiE "health|webhook|track-click|csrf-token|csp-violation"; then
            continue
        fi

        if echo "$snippet" | grep -q "csrfProtection"; then
            continue
        fi

        CSRF_VIOLATIONS+="+  $file:$ln:  $route_line\n"
    done
done

if [ -n "$CSRF_VIOLATIONS" ]; then
    echo -e "${RED}✗ BLOCKER 11: POST/PUT/PATCH/DELETE routes without csrfProtection${NC}"
    echo "  ${RED}RISK:${NC} Attackers can forge requests to modify/delete user data"
    echo "  ${CYAN}VIOLATIONS FOUND:${NC}"
    echo -e "$CSRF_VIOLATIONS" | head -20
    echo ""
    echo "  ${CYAN}FIX:${NC} Add csrfProtection middleware to ALL state-changing routes"
    echo "  ${CYAN}EXAMPLE:${NC}"
    echo "    import { csrfProtection } from '../middleware/security';"
    echo "    app.post('/api/resource', csrfProtection, withAuth(handler));"
    echo ""
    echo "  ${CYAN}EXEMPTIONS:${NC} Add comment if truly exempt:"
    echo "    // CSRF exempt: Public webhook with signature verification"
    echo "    app.post('/api/webhook', webhookHandler);"
    echo ""
    echo "  ${CYAN}DOCS:${NC} docs/04_SECURITY_PATTERNS.md#csrf-protection---single-source-of-truth"
    echo ""
    SECURITY_ISSUES=1
fi

# ============================================================================
# HIGH PRIORITY WARNINGS (Strong recommendations, not blockers)
# ============================================================================

# WARNING 1: Missing transaction boundaries (can cause data corruption)
if echo "$TS_FILES" | xargs git diff --cached 2>/dev/null | grep -E "^\+" | grep -E "await db\.(insert|update|delete)" | grep -B 3 -A 3 "await db\.(insert|update|delete)" | grep -v "db.transaction" | grep -v "^\-\-" | wc -l | tr -d ' ' | grep -v "^[012]$" >/dev/null 2>&1; then
    echo -e "${YELLOW}⚠ WARNING 1: Multiple DB operations without transaction detected${NC}"
    echo "  ${YELLOW}RISK:${NC} Multi-step operations can leave database in inconsistent state"
    echo "  ${CYAN}FIX:${NC} Wrap related operations in db.transaction() for atomicity"
    echo "  ${CYAN}EXAMPLE:${NC} await db.transaction(async (tx) => { await tx.insert(...); await tx.update(...); })"
    echo "  ${CYAN}DOCS:${NC} See docs/DATABASE_PATTERNS.md for transaction guidelines"
    echo ""
    WARNINGS=$((WARNINGS + 1))
fi

# WARNING 2: Missing input validation (Zod schema)
if echo "$STAGED_FILES" | grep "routes/" | xargs git diff --cached 2>/dev/null | grep -E "^\+" | grep "req\.body" | grep -v "\.parse\|\.safeParse" >/dev/null 2>&1; then
    echo -e "${YELLOW}⚠ WARNING 2: req.body usage without Zod validation${NC}"
    echo "  ${YELLOW}RISK:${NC} Invalid data can reach business logic and cause errors"
    echo "  ${CYAN}FIX:${NC} Validate all inputs with Zod schemas"
    echo "  ${CYAN}EXAMPLE:${NC} const data = insertUserSchema.parse(req.body)"
    echo ""
    WARNINGS=$((WARNINGS + 1))
fi

# WARNING 3: Missing authentication on protected routes
if echo "$STAGED_FILES" | grep "routes/" | xargs git diff --cached 2>/dev/null | grep -E "^\+" | grep -E "app\.(post|put|delete|patch).*['\"].*/(admin|user)/" | grep -v "requireAuth" | grep -v "requireAdmin" >/dev/null 2>&1; then
    echo -e "${YELLOW}⚠ WARNING 3: Protected route without authentication middleware${NC}"
    echo "  ${YELLOW}RISK:${NC} Unauthorized users may access protected resources"
    echo "  ${CYAN}FIX:${NC} Add requireAuth or requireAdmin middleware"
    echo "  ${CYAN}EXAMPLE:${NC} app.post('/api/admin/users', requireAdmin, async (req, res) => {...})"
    echo ""
    WARNINGS=$((WARNINGS + 1))
fi

# WARNING 4: Missing error handling in async routes
if echo "$STAGED_FILES" | grep "routes/" | xargs git diff --cached 2>/dev/null | grep -E "^\+" | grep "async.*\(req.*res\)" | head -5 | grep -v "try" >/dev/null 2>&1; then
    echo -e "${YELLOW}⚠ WARNING 4: Async route handler without try/catch${NC}"
    echo "  ${YELLOW}RISK:${NC} Unhandled promise rejections can crash the server"
    echo "  ${CYAN}FIX:${NC} Wrap async route handlers in try/catch blocks"
    echo "  ${CYAN}EXAMPLE:${NC} try { await operation(); } catch (error) { const err = createErrorResponse(error); }"
    echo ""
    WARNINGS=$((WARNINGS + 1))
fi

