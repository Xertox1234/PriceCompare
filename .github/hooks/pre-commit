# WARNING 9: Client-side data aggregation (frontend N+1 pattern)
if echo "$STAGED_FILES" | grep -E "client/.*hooks/.*\.ts" | xargs git diff --cached 2>/dev/null | grep -E "^\+" | grep -E "for.*of.*\)" | grep -A 3 "for" | grep "\.map\|\.filter\|\.push" >/dev/null 2>&1; then
    echo -e "${YELLOW}⚠ WARNING 9: Potential client-side data aggregation detected${NC}"
    echo "  ${YELLOW}REASON:${NC} Aggregating data client-side can cause massive overfetch"
    echo "  ${CYAN}FIX:${NC} Create dedicated backend endpoint for aggregated data"
    echo "  ${CYAN}EXAMPLE:${NC} GET /api/watchlists/products instead of fetching all lists + aggregating"
    echo "  ${CYAN}DOCS:${NC} See docs/FRONTEND_PATTERNS.md for client-side anti-patterns"
    echo ""
    WARNINGS=$((WARNINGS + 1))
fi

# WARNING 10: Background jobs without rate limiting
JOB_FILES=$(echo "$STAGED_FILES" | grep "jobs/" || true)
if [ -n "$JOB_FILES" ]; then
    JOB_DIFF=$(echo "$JOB_FILES" | xargs git diff --cached 2>/dev/null || true)
    if echo "$JOB_DIFF" | grep -qE "^\+.*(sendNotification|createNotification|emailService)"; then
        if ! echo "$JOB_DIFF" | grep -qE "^\+.*MAX_.*PER"; then
            echo -e "${YELLOW}⚠ WARNING 10: Background job without rate limiting detected${NC}"
            echo "  ${YELLOW}REASON:${NC} Jobs without circuit breakers can spam if logic malfunctions"
            echo "  ${CYAN}FIX:${NC} Add per-run limit: const MAX_NOTIFICATIONS_PER_RUN = 5;"
            echo "  ${CYAN}EXAMPLE:${NC} if (sentThisRun >= MAX_PER_RUN) break; // Safety valve"
            echo "  ${CYAN}DOCS:${NC} See docs/BACKGROUND_JOBS_PATTERNS.md for job safety patterns"
            echo ""
            WARNINGS=$((WARNINGS + 1))
        fi
    fi
fi

# WARNING 11: Check-then-act patterns without SERIALIZABLE isolation (Race conditions)
echo "🔒 Checking for race condition patterns..."
CHECK_THEN_ACT=$(grep -rn -A10 -F ".select(" server/ --include="*.ts" 2>/dev/null | \
    grep -B5 -E "\.(insert|update|delete)" | \
  grep "count\|length\|>=" | \
  grep -v "serializable" | \
  grep -v "__tests__" | \
  grep -v "\.test\." || true)

if [ -n "$CHECK_THEN_ACT" ]; then
    echo -e "${YELLOW}⚠ WARNING 11: Potential check-then-act without SERIALIZABLE isolation detected${NC}"
    echo "  ${YELLOW}RISK:${NC} Race conditions in concurrent operations (e.g., first user check, counter increments)"
    echo ""
    echo "  ${CYAN}PATTERN FOUND (first 10 lines):${NC}"
    echo "$CHECK_THEN_ACT" | head -10 | sed 's/^/    /'
    echo ""
    echo "  ${CYAN}FIX:${NC} Use SERIALIZABLE isolation for check-then-act patterns"
    echo "  ${CYAN}EXAMPLE:${NC}"
    echo "    await db.transaction(async (tx) => {"
    echo "      const count = await tx.select({ count: sql\`count(*)\` }).from(users);"
    echo "      const isFirstUser = parseInt(count[0].count as string) === 0;"
    echo "      await tx.insert(users).values({ role: isFirstUser ? 'admin' : 'user' });"
    echo "    }, { isolationLevel: 'serializable' });"
    echo ""
    echo "  ${CYAN}DOCS:${NC} docs/02_DATABASE_PATTERNS.md#serializable-isolation"
    echo ""
    WARNINGS=$((WARNINGS + 1))
fi

# WARNING 12: Hardcoded password lengths (should use PASSWORD constants)
echo "🔑 Checking password constant usage..."
HARDCODED_PW=$(grep -rn "\.min(8)\|\.min(12)" server/ --include="*.ts" 2>/dev/null | \
  grep -i "password" | \
