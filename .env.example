# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/price_db
POSTGRES_PASSWORD=your_postgres_password

# ==================================================================================
# CRITICAL SECURITY CONFIGURATION
# ==================================================================================
# The following secrets are REQUIRED in ALL environments (including development).
# Strong secrets are enforced to prevent weak secrets from reaching production.
# Generate secure random values using: openssl rand -base64 32
# NEVER commit actual secret values to version control!
# Each secret must be at least 32 characters long.
# ==================================================================================

# Session Secret - REQUIRED
# Used for encrypting session cookies
# Generate with: openssl rand -base64 32
SESSION_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_VALUE_AT_LEAST_32_CHARS

# CSRF Secret - REQUIRED
# Used for generating CSRF protection tokens
# Generate with: openssl rand -base64 32
CSRF_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_VALUE_AT_LEAST_32_CHARS

# Encryption Key - REQUIRED (GDPR COMPLIANCE)
# Used for encrypting PII data at rest (email, IP addresses, private messages)
# CRITICAL: This key encrypts sensitive user data. If lost, encrypted data cannot be recovered.
# Generate with: openssl rand -hex 32
# MUST be 64 hex characters (32 bytes = 256 bits for AES-256)
# Store securely and never commit to version control
ENCRYPTION_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_HEX_VALUE_64_CHARS

# Discourse SSO Secret - REQUIRED
# Used for HMAC signing of SSO tokens (critical for authentication security)
# Generate with: openssl rand -base64 32
# This MUST match the secret configured in your Discourse instance
DISCOURSE_SSO_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_VALUE_AT_LEAST_32_CHARS

# Discourse Webhook Secret - OPTIONAL (recommended)
# Used for verifying webhook signatures from Discourse
# Generate with: openssl rand -base64 32
# Falls back to DISCOURSE_SSO_SECRET if not set
# This MUST match the webhook secret configured in Discourse
DISCOURSE_WEBHOOK_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_VALUE_AT_LEAST_32_CHARS

# Discourse Configuration
DISCOURSE_URL=http://localhost:3000
DISCOURSE_API_KEY=your_discourse_api_key
DISCOURSE_DB_PASSWORD=discourse_password_2024

# ==================================================================================
# EMAIL CONFIGURATION (OPTIONAL BUT REQUIRED FOR PASSWORD RESET)
# ==================================================================================
# Email service is used for password reset functionality and other user notifications.
# If not configured, password reset feature will be unavailable.
# ==================================================================================

# SMTP Server Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_ADDRESS=noreply@pricecompare.com

# Application URL - Used in password reset emails
# This should be the full URL where your app is accessible
APP_URL=http://localhost:5000

# Admin Configuration
ADMIN_EMAIL=admin@yoursite.com

# External API Keys
OPENAI_API_KEY=your_openai_api_key
GOOGLE_CUSTOM_SEARCH_API_KEY=your_google_search_api_key
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id

# ==================================================================================
# REDIS CONFIGURATION (REQUIRED IN PRODUCTION)
# ==================================================================================
# Redis is MANDATORY in production environments for:
#   - Distributed rate limiting across multiple server instances
#   - Session storage shared across all application servers
#   - Distributed caching for optimal performance
#   - Account lockout tracking across instances
#
# Production deployment will FAIL if REDIS_URL is not configured.
# Development mode allows optional Redis with in-memory fallback (with warnings).
# ==================================================================================

# Redis URL - REQUIRED in production, OPTIONAL in development
# For local Redis:        redis://localhost:6379
# For Redis with auth:    redis://:password@localhost:6379
# For Redis Cloud/Upstash: rediss://username:password@host:port
# For SSL/TLS:            rediss://username:password@host:port
#
# Recommended managed Redis providers:
#   - Upstash: https://upstash.com (free tier available)
#   - Redis Cloud: https://redis.com/try-free
#   - AWS ElastiCache: https://aws.amazon.com/elasticache
#   - Azure Cache for Redis: https://azure.microsoft.com/services/cache
#
# In production: App will exit with error if not configured
# In development: App will warn and use in-memory fallback
REDIS_URL=redis://localhost:6379

# Redis Connection Details (for distributed caching)
# Used by the AI agent query cache and general caching services
# Defaults: localhost:6379 (no password)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==================================================================================
# CACHING CONFIGURATION (OPTIONAL - PERFORMANCE TUNING)
# ==================================================================================
# L1 Cache (In-Memory LRU Cache) Configuration
# L1 cache provides 1-5ms response times (vs 5-10ms for Redis L2 cache)
# ==================================================================================

# L1 Cache Size - Number of items to store in memory
# Default: 2500 (increased from 1000 for better hit rates)
# Recommended range: 1000-5000 depending on available memory
# Memory usage: ~50KB per item (2500 items = ~125MB)
# Higher values improve cache hit rates but use more memory
L1_CACHE_SIZE=2500

# L1 Cache TTL - Time-to-live in seconds for L1 cache entries
# Default: 60 seconds
# Recommended range: 30-120 seconds
# Shorter TTL = fresher data, lower hit rate
# Longer TTL = higher hit rate, potentially stale data
L1_CACHE_TTL=60

# ==================================================================================
# MONITORING & ALERTS
# ==================================================================================

# Sentry Error Monitoring (OPTIONAL BUT RECOMMENDED)
# Get DSN from: https://sentry.io (after creating a project)
# Enables real-time error tracking and performance monitoring
# Leave empty to disable Sentry (errors will still be logged locally)
# Backend Sentry DSN
SENTRY_DSN=
# Frontend Sentry DSN (can be same as backend or separate project)
VITE_SENTRY_DSN=
# Optional: Set release version for tracking (defaults to package version)
# SENTRY_RELEASE=1.0.0
# VITE_SENTRY_RELEASE=1.0.0

# Content Security Policy Enforcement (OPTIONAL)
# Controls whether CSP violations are reported (false) or enforced (true)
# false = Report-Only mode (logs violations but doesn't block)
# true  = Enforcement mode (blocks violations)
# Recommended: Start with false, monitor for 24-48 hours, then enable
# Default: false (report-only for safety)
# CSP_ENFORCE=false

# Slack Webhook URL for alerts (OPTIONAL)
# Get webhook URL from: https://api.slack.com/messaging/webhooks
# Leave empty to disable Slack notifications
# Alerts will still appear in the dashboard and logs
SLACK_WEBHOOK_URL=