# Secrets Scanner Ignore File
# Files and patterns to ignore during secret scanning

# Example files (safe to have example secrets)
.env.example
*.example
*.sample

# Test files (may contain mock credentials)
**/__tests__/**
**/__mocks__/**
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx

# Documentation
*.md
docs/**
SECURITY_FIXES.md
SECURITY_AUDIT_REPORT.md

# Configuration examples
tsconfig.json
package.json
package-lock.json

# Build artifacts
dist/**
build/**
node_modules/**
.next/**

# Safe patterns (not actual secrets)
CHANGE_THIS_TO_A_SECURE_RANDOM_VALUE
your_*
example_*
<generated_value>
placeholder

# Development/localhost URLs (not production secrets)
http://localhost:*
127.0.0.1
