#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Running pre-commit security checks..."

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Track if any checks fail
FAILED=0

# 1. Check for hardcoded secrets
echo "🔐 Checking for hardcoded secrets..."
if git diff --cached --name-only | grep -E '\.(ts|tsx|js|jsx|json|env)$' | xargs grep -nHE '(password|secret|api[_-]?key|token|bearer)\s*[:=]\s*["\'][^"\']+["\']' 2>/dev/null | grep -v "process.env" | grep -v "CHANGE_THIS" | grep -v "your_" | grep -v "example" | grep -v ".env.example"; then
  echo "${RED}❌ ERROR: Potential hardcoded secrets found!${NC}"
  echo "   Please use environment variables instead."
  FAILED=1
else
  echo "${GREEN}✅ No hardcoded secrets detected${NC}"
fi

# 2. Check for console.log in production code (server side)
echo "🪵 Checking for console.log statements in server code..."
if git diff --cached --name-only | grep -E 'server/.*\.(ts|js)$' | xargs grep -nH "console\.log" 2>/dev/null | grep -v "// SECURITY:" | grep -v "development"; then
  echo "${YELLOW}⚠️  WARNING: console.log found in server code${NC}"
  echo "   Consider using proper logging or removing in production"
  # Don't fail, just warn
else
  echo "${GREEN}✅ No problematic console.log statements${NC}"
fi

# 3. Check for TODO/FIXME security items
echo "📝 Checking for security-related TODOs..."
if git diff --cached --name-only | xargs grep -nHE "(TODO|FIXME|XXX).*(security|password|secret|vulnerability|exploit)" 2>/dev/null; then
  echo "${YELLOW}⚠️  WARNING: Security-related TODOs found${NC}"
  echo "   Please address before merging to main"
  # Don't fail, just warn
fi

# 4. Check TypeScript compilation
echo "🔧 Type checking TypeScript files..."
if git diff --cached --name-only | grep -E '\.(ts|tsx)$' > /dev/null; then
  if ! npm run check 2>&1 | grep -E "(error TS|Cannot find)" | head -5; then
    echo "${GREEN}✅ TypeScript compilation passed${NC}"
  else
    echo "${YELLOW}⚠️  TypeScript warnings detected (not blocking)${NC}"
  fi
fi

# 5. Check for vulnerable patterns
echo "🛡️  Checking for vulnerable code patterns..."
VULNERABLE=0

# Check for SQL injection patterns
if git diff --cached --name-only | xargs grep -nHE '(query|execute).*\+.*req\.(body|params|query)' 2>/dev/null; then
  echo "${RED}❌ Potential SQL injection vulnerability detected!${NC}"
  FAILED=1
  VULNERABLE=1
fi

# Check for XSS patterns
if git diff --cached --name-only | grep -E '\.(tsx|jsx)$' | xargs grep -nH "dangerouslySetInnerHTML" 2>/dev/null; then
  echo "${YELLOW}⚠️  WARNING: dangerouslySetInnerHTML usage detected${NC}"
  echo "   Ensure content is properly sanitized"
fi

# Check for eval usage
if git diff --cached --name-only | xargs grep -nHE '\beval\s*\(' 2>/dev/null; then
  echo "${RED}❌ eval() usage detected - potential security risk!${NC}"
  FAILED=1
  VULNERABLE=1
fi

if [ $VULNERABLE -eq 0 ]; then
  echo "${GREEN}✅ No obvious vulnerable patterns detected${NC}"
fi

# 6. Check environment variable usage
echo "🌍 Validating environment variable usage..."
if git diff --cached --name-only | xargs grep -nHE 'process\.env\.[A-Z_]+\s*\|\|' 2>/dev/null | grep -v "getOptionalEnv" | grep -v "'http://localhost" | grep -v "development"; then
  echo "${YELLOW}⚠️  WARNING: Fallback values for env vars detected${NC}"
  echo "   Consider using getRequiredEnv() or getOptionalEnv()"
fi

# 7. Check for sensitive file changes
echo "📄 Checking for sensitive file changes..."
if git diff --cached --name-only | grep -E '(\.env$|\.env\.local|\.env\.production|id_rsa|\.pem$|\.key$)'; then
  echo "${RED}❌ ERROR: Attempting to commit sensitive files!${NC}"
  echo "   Please remove these from your commit"
  FAILED=1
fi

# Summary
echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
if [ $FAILED -eq 0 ]; then
  echo "${GREEN}✅ All security checks passed!${NC}"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  exit 0
else
  echo "${RED}❌ Security checks failed!${NC}"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo ""
  echo "To bypass these checks (NOT recommended):"
  echo "  git commit --no-verify"
  echo ""
  exit 1
fi
