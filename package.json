{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development tsx server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ai": "vitest run server/ai/__tests__",
    "test:security": "vitest run server/__tests__/security",
    "db:push": "drizzle-kit push",
    "migrate": "tsx scripts/run-migrations.ts",
    "generate-embeddings": "tsx scripts/generate-embeddings.ts",
    "security:scan": "bash scripts/security-scan.sh",
    "security:audit": "npm audit --audit-level=moderate",
    "security:fix": "npm audit fix",
    "security:check": "bash scripts/security-checks.sh",
    "security:full": "npm run security:check && npm run test:security",
    "lint:security": "eslint --config eslint.security.config.mjs server/**/*.ts",
    "prepare": "command -v husky >/dev/null 2>&1 && husky install || true"
  },
